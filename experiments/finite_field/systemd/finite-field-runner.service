[Unit]
Description=Resume the matched finite-field GPU sweep
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kanhar
WorkingDirectory=/home/kanhar/nanoGPT
Environment=AUTO_SHUTDOWN=1
ExecStart=/bin/bash experiments/finite_field/gpu_run.sh
ExecStopPost=+/bin/sh -c '/usr/sbin/shutdown -c || true; /usr/bin/systemctl --no-block start finite-field-watch.service'
TimeoutStopSec=60
StandardOutput=append:/home/kanhar/nanoGPT/training.log
StandardError=append:/home/kanhar/nanoGPT/training.log
